# Pega las cadenas tal como las copias del panel de Neon (Connection string).
# La app convierte sola el formato (sslmode/channel_binding) para asyncpg.
# Pooled (host con "-pooler"): la usa la app.
DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/transdemo?sslmode=require&channel_binding=require
# Directa (sin "-pooler"): la usa Alembic para las migraciones.
DATABASE_URL_DIRECT=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/transdemo?sslmode=require&channel_binding=require

APP_ENV=development
APP_TZ=America/La_Paz

# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambiar
JWT_EXPIRE_MINUTES=480

# Tu número de prueba (solo dígitos, con 591). Las guías y reservas de prueba se asocian a él.
DEMO_TELEFONO_E164=591XXXXXXXX

# Separados por coma
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Cada cuántos segundos se liberan reservas vencidas (0 = desactivado)
JOB_EXPIRAR_RESERVAS_SEGUNDOS=60

# --- Seguridad ---
# true en producción (HTTPS): la cookie de sesión viaja solo por HTTPS y se envía HSTS.
COOKIE_SECURE=false
# Límite de intentos (login, compras, rastreo). Ponlo en false solo para pruebas automatizadas.
RATE_LIMIT_ENABLED=true
# Documentación interactiva (/docs). Recomendado false en producción.
DOCS_ENABLED=true
# true solo si la API está detrás de un proxy de confianza que envía X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# --- Agente de voz (ElevenLabs) ---
# Solicitudes por minuto permitidas a cada API key (cabecera X-Bot-Key).
BOT_RATE_LIMIT_POR_MINUTO=120

# --- Compra de pasajes por WhatsApp ---
# URL pública del frontend: el bot envía el enlace WEB_PUBLICA_URL/pagar/CÓDIGO con el QR de pago.
WEB_PUBLICA_URL=https://transdemo-bo.vercel.app
# API key de ElevenLabs (permiso ElevenAgents: escritura): descarga comprobantes y envía las plantillas de WhatsApp.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_WHATSAPP_PHONE_NUMBER_ID=
# Secreto del webhook post-llamada (ElevenLabs → Configuración → Webhooks).
ELEVENLABS_WEBHOOK_SECRET=
# Respaldo del webhook: cada cuántos segundos se buscan imágenes de comprobantes pendientes (0 = desactivado).
JOB_COMPROBANTES_SEGUNDOS=120
